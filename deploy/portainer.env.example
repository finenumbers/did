# Paste into Portainer → Stack → Environment variables
# (or save as stack env file). Do not commit real secrets.

# ALWAYS redeploy with latest GHCR images (updated on every push to main / release)
DID_IMAGE_TAG=latest
PROXY_NETWORK_NAME=proxy

POSTGRES_USER=did
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=did

# Public UI origin as seen in the browser (NPM host), comma-separated if several
BACKEND_CORS_ORIGINS=https://did.example.com

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password
ADMIN_SESSION_SECRET=change-me-long-random-secret
ADMIN_API_TOKEN=

NEXT_PUBLIC_API_URL=/api/backend
BACKEND_INTERNAL_URL=http://backend:8000
