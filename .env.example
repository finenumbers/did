POSTGRES_USER=did
POSTGRES_PASSWORD=did
POSTGRES_DB=did
DATABASE_URL=postgresql+psycopg://did:did@db:5432/did
# Local / direct ports. For Portainer+NPM use https://your-did-host
BACKEND_CORS_ORIGINS=http://localhost:3000

# Browser → Next proxy (same-origin under NPM)
NEXT_PUBLIC_API_URL=/api/backend
BACKEND_INTERNAL_URL=http://backend:8000

# Portainer stack image tag / NPM network name (see deploy/PORTAINER.md)
DID_IMAGE_TAG=0.1.1
PROXY_NETWORK_NAME=proxy

# Admin login (required for API protection)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
ADMIN_SESSION_SECRET=change-this-session-secret

# Optional machine Bearer token (CI/scripts)
ADMIN_API_TOKEN=

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
